        "/api/players": {
            "get": {
                "tags": [
                    "Players"
                ],
                "summary": "Get list of players",
                "description": "Returns a list of players with optional filters by name, position, or club. Supports pagination or returning all players.",
                "operationId": "a355f9879160729f824bdea53e739b05",
                "parameters": [
                    {
                        "name": "name",
                        "in": "query",
                        "description": "Filter players by first or second name",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "Haaland"
                        }
                    },
                    {
                        "name": "position",
                        "in": "query",
                        "description": "Filter players by position (GKP, DEF, MID, FWD)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "FWD"
                        }
                    },
                    {
                        "name": "club",
                        "in": "query",
                        "description": "Filter players by club name",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "Manchester City"
                        }
                    },
                    {
                        "name": "all",
                        "in": "query",
                        "description": "If set, returns all players without pagination",
                        "required": false,
                        "schema": {
                            "type": "boolean",
                            "example": true
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "Number of players per page (default 10)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 10
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of players",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "first_name": {
                                                        "type": "string",
                                                        "example": "Erling"
                                                    },
                                                    "second_name": {
                                                        "type": "string",
                                                        "example": "Haaland"
                                                    },
                                                    "position": {
                                                        "type": "string",
                                                        "example": "FWD"
                                                    },
                                                    "club_id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "price": {
                                                        "type": "integer",
                                                        "example": 12000000
                                                    },
                                                    "total_points": {
                                                        "type": "integer",
                                                        "example": 50
                                                    },
                                                    "assists": {
                                                        "type": "integer",
                                                        "example": 10
                                                    },
                                                    "goals": {
                                                        "type": "integer",
                                                        "example": 20
                                                    },
                                                    "expected_goals": {
                                                        "type": "number",
                                                        "format": "float",
                                                        "example": 18.5
                                                    },
                                                    "expected_assists": {
                                                        "type": "number",
                                                        "format": "float",
                                                        "example": 9.2
                                                    },
                                                    "gw1_points": {
                                                        "type": "integer",
                                                        "example": 6
                                                    },
                                                    "gw2_points": {
                                                        "type": "integer",
                                                        "example": 10
                                                    },
                                                    "gw3_points": {
                                                        "type": "integer",
                                                        "example": 4
                                                    },
                                                    "gw4_points": {
                                                        "type": "integer",
                                                        "example": 8
                                                    },
                                                    "gw5_points": {
                                                        "type": "integer",
                                                        "example": 2
                                                    },
                                                    "club": {
                                                        "description": "Associated club",
                                                        "properties": {
                                                            "id": {
                                                                "type": "integer",
                                                                "example": 1
                                                            },
                                                            "name": {
                                                                "type": "string",
                                                                "example": "Manchester City"
                                                            }
                                                        },
                                                        "type": "object"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "No players found"
                    }
                }
            }
        },
